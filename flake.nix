{
  description = "WordCraft development environment";

  inputs.nixpkgs.url = "github:NixOS/nixpkgs/nixos-26.05";

  outputs = { self, nixpkgs }:
    let
      system = "x86_64-linux";
      pkgs = import nixpkgs { inherit system; };
      
      # Load output hashes for git dependencies (generated by gen-hashes.sh + filter-hashes.py)
      cargoOutputHashes = if builtins.pathExists ./hashes-filtered.json
        then builtins.fromJSON (builtins.readFile ./hashes-filtered.json)
        else {};
      
      wordcraftPackage = pkgs.rustPlatform.buildRustPackage {
        pname = "wordcraft";
        version = "0.12.0";
        src = self;
        cargoLock = {
          lockFile = ./Cargo.lock;
          outputHashes = cargoOutputHashes;
        };
        nativeBuildInputs = with pkgs; [ pkg-config clang cmake ];
        buildInputs = with pkgs; [
          wayland
          libxkbcommon
          fontconfig
          freetype
          vulkan-loader
          libGL
          libX11
          libXext
          libXcursor
          libXfixes
          libXi
          libXrandr
          libXrender
          libXScrnSaver
          libXtst
          libXxf86vm
          libxcb
          xorgproto
        ];
        cargoBuildFlags = ["--bin" "wordcraft"];
        doCheck = false;
        patchPhase = ''
          # Remove unused egui patches that cause validation errors
          sed -i '/egui_demo_lib = /d' Cargo.toml
          sed -i '/egui_extras = /d' Cargo.toml
          sed -i '/egui_inspection = /d' Cargo.toml
          sed -i '/egui_system_font_provider = /d' Cargo.toml
          sed -i '/egui_demo_lib = /d' Cargo.toml
        '';
      };
    in {
      packages.${system}.default = wordcraftPackage;
      
      devShells.${system}.default = pkgs.mkShell {
        packages = with pkgs; [
          rustc
          cargo
          rustfmt
          clippy
          pkg-config
          clang
          cmake
          wayland
          libxkbcommon
          fontconfig
          freetype
          vulkan-loader
          libGL
          libX11
          libXext
          libXcursor
          libXfixes
          libXi
          libXrandr
          libXrender
          libXScrnSaver
          libXtst
          libXxf86vm
          libxcb
          xorgproto
        ];

        shellHook = ''
          export LD_LIBRARY_PATH="${pkgs.lib.makeLibraryPath [
            pkgs.wayland
            pkgs.libxkbcommon
            pkgs.fontconfig
            pkgs.freetype
            pkgs.vulkan-loader
            pkgs.libGL
            pkgs.libX11
            pkgs.libXext
            pkgs.libXcursor
            pkgs.libXfixes
            pkgs.libXi
            pkgs.libXrandr
            pkgs.libXrender
            pkgs.libXScrnSaver
            pkgs.libXtst
            pkgs.libXxf86vm
            pkgs.libxcb
          ]}:''${LD_LIBRARY_PATH:-}"
        '';
      };
    };
}
