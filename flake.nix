{
  description = "WordCraft development environment";

  inputs.nixpkgs.url = "github:NixOS/nixpkgs/nixos-unstable";

  outputs = { self, nixpkgs }:
    let
      system = "x86_64-linux";
      pkgs = import nixpkgs { inherit system; };
      
      # Load output hashes for git dependencies (generated by gen-hashes.sh + filter-hashes.py)
      cargoOutputHashes = if builtins.pathExists ./hashes-filtered.json
        then builtins.fromJSON (builtins.readFile ./hashes-filtered.json)
        else {};
      
      # Runtime libraries that the binary dlopen's (libxkbcommon-x11 is part of libxkbcommon)
      runtimeLibs = with pkgs; [
        wayland
        libxkbcommon
        fontconfig
        freetype
        vulkan-loader
        libGL
        libX11
        libXext
        libXcursor
        libXfixes
        libXi
        libXrandr
        libXrender
        libXScrnSaver
        libXtst
        libXxf86vm
        libxcb
      ];
      
      wordcraftPackage = pkgs.rustPlatform.buildRustPackage {
        pname = "wordcraft";
        version = "0.12.0";
        src = self;
        cargoLock = {
          lockFile = ./Cargo.lock;
          outputHashes = cargoOutputHashes;
        };
        nativeBuildInputs = with pkgs; [ pkg-config clang cmake makeWrapper ];
        buildInputs = with pkgs; [
          wayland
          libxkbcommon
          fontconfig
          freetype
          vulkan-loader
          libGL
          libX11
          libXext
          libXcursor
          libXfixes
          libXi
          libXrandr
          libXrender
          libXScrnSaver
          libXtst
          libXxf86vm
          libxcb
          xorgproto
        ];
        cargoBuildFlags = ["--bin" "wordcraft"];
        doCheck = false;
        patchPhase = ''
          # Disable startup update check: the updater tries to write to the read-only nix store
          sed -i 's|app.set_startup_update_check(true);|// app.set_startup_update_check(true);|' apps/wordcraft/src/main.rs
          # Remove unused egui patches that cause validation errors
          sed -i '/egui_demo_lib = /d' Cargo.toml
          sed -i '/egui_extras = /d' Cargo.toml
          sed -i '/egui_inspection = /d' Cargo.toml
          sed -i '/egui_system_font_provider = /d' Cargo.toml
          sed -i '/egui_demo_lib = /d' Cargo.toml
        '';
        postInstall = ''
          # Wrap the binary to include runtime libraries
          wrapProgram $out/bin/wordcraft --prefix LD_LIBRARY_PATH : "${pkgs.lib.makeLibraryPath runtimeLibs}"
        '';
      };
    in {
      packages.${system}.default = wordcraftPackage;
      
      devShells.${system}.default = pkgs.mkShell {
        packages = with pkgs; [
          rustc
          cargo
          rustfmt
          clippy
          pkg-config
          clang
          cmake
          wayland
          libxkbcommon
          fontconfig
          freetype
          vulkan-loader
          libGL
          libX11
          libXext
          libXcursor
          libXfixes
          libXi
          libXrandr
          libXrender
          libXScrnSaver
          libXtst
          libXxf86vm
          libxcb
          xorgproto
        ];

        shellHook = ''
          export LD_LIBRARY_PATH="${pkgs.lib.makeLibraryPath runtimeLibs}:$LD_LIBRARY_PATH"
        '';
      };
    };
}